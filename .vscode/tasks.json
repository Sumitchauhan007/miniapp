{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "backend: run flask app",
			"type": "shell",
			"command": "backend\\env\\Scripts\\python",
			"args": [
				"backend\\app.py"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "frontend: install deps",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend\\frontend",
				"install"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "frontend: dev server",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-Command",
				"Set-Location frontend\\frontend; npm install; npm run dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}